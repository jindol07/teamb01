		INSERT ALL
		<foreach collection="list" item="item"> 
			INTO p_survey_answer values (p_survey_answer_seq.NEXTVAL, #{item.userid}, #{item.surveyid}, #{item.questionid}, #{item.answerdataJson}, sysdate)
		</foreach>
		SELECT * FROM DUAL
	</insert>-->
</mapper>